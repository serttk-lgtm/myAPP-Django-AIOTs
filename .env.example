# =========================
# Django Core
# =========================
SECRET_KEY=change-this-to-a-strong-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# =========================
# Database
# Required: PostgreSQL only (SQLite fallback is disabled)
# For Render/Postgres set full URL, e.g.
# postgresql://user:password@host:5432/dbname
# For Supabase pooler (recommended for simple setup), e.g.
# postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres
# =========================
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Use 0 with poolers (pgbouncer/session pooler) to avoid stale pooled connections.
DB_CONN_MAX_AGE=0
