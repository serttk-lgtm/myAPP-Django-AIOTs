# =========================
# Django Core
# =========================
SECRET_KEY=change-this-to-a-strong-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# =========================
# Database
# =========================
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres
# Use 0 with poolers (pgbouncer/session pooler) to avoid stale pooled connections.
DB_CONN_MAX_AGE=0

#MQTT Settings
RUN_MQTT_IN_WEBSERVICE=True
# =========================
# MQTT Configuration
# For Smart Farm AIoT System
# =========================
# MQTT Broker hostname or IP address
MQTT_BROKER=broker.hivemq.com
# MQTT Broker port (1883 for TCP, 8883 for SSL/TLS)
MQTT_PORT=1883